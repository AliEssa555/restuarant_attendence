FROM eclipse-temurin:21-jre-jammy AS java
FROM node:22-bookworm-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
ENV CI=true
ENV FIREBASE_CLI_DISABLE_UPDATE_CHECK=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libstdc++6 zlib1g && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY firebase/functions/package*.json firebase/functions/
COPY scripts/package*.json scripts/
RUN npm ci --prefix firebase/functions && npm ci --prefix scripts && npm install --global firebase-tools@15.34.2
COPY firebase firebase
COPY scripts scripts
COPY demo demo
COPY firebase.demo.json ./
RUN npm --prefix firebase/functions run build && firebase setup:emulators:firestore && firebase setup:emulators:ui
EXPOSE 9099 8080 5001 4000
ENTRYPOINT ["node", "demo/start-backend.mjs"]
