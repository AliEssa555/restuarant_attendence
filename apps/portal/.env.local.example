# Firebase client configuration for the manager portal.
#
# None of these are secrets: Firebase web config is public by design, and all
# access control lives in the Firestore/Storage security rules and in the
# `assertRole` check inside every callable. The portal never uses
# `firebase-admin`.
#
# Copy this file to `.env.local` and fill it in with the values from
# Firebase console -> Project settings -> Your apps -> Web app.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match REGION in firebase/functions/src/config.ts.
NEXT_PUBLIC_FUNCTIONS_REGION=asia-south1

# --- Local development against the Emulator Suite -------------------------
# With this set to true, every Firebase service is redirected to the local
# emulators and the values above can be dummies (the emulators do not check
# them) — except PROJECT_ID, which must match `.firebaserc`.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
