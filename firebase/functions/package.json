{
  "name": "@restaurant-attendance/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for the Restaurant Attendance demo",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "jsqr": "^1.4.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
