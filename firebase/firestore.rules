rules_version = '2';

// Restaurant Attendance — Firestore security rules (see TECHNICAL_PLAN.md §9).
//
// Guiding principle: clients never write attendance, presence, face data or
// anything privileged. Those writes go through Cloud Functions callables with
// the Admin SDK, which bypasses these rules. Everything a client *can* write is
// field-whitelisted below.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function claims() {
      return request.auth.token;
    }
    function rid() {
      return isSignedIn() ? claims().get('rid', '') : '';
    }
    function role() {
      return isSignedIn() ? claims().get('role', '') : '';
    }
    function eid() {
      return isSignedIn() ? claims().get('eid', '') : '';
    }
    function isMemberOf(r) {
      return isSignedIn() && rid() == r;
    }
    function isStaffOf(r) {
      return isMemberOf(r) && (role() == 'owner' || role() == 'manager');
    }
    function isOwnerOf(r) {
      return isMemberOf(r) && role() == 'owner';
    }
    function isEmployeeSelf(r, e) {
      return isMemberOf(r) && role() == 'employee' && eid() == e;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users ----------
    // Read: your own doc, or any user of your restaurant if you are staff.
    // Write: only clearing your own mustChangePassword flag after a successful
    // password change. Creation is done by createRestaurant / createEmployee.
    match /users/{uid} {
      allow get, list: if isSignedIn() && (
        request.auth.uid == uid ||
        (isStaffOf(resource.data.restaurantId))
      );

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && changedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;

      allow create, delete: if false;
    }

    // ---------- restaurants ----------
    match /restaurants/{rid} {
      allow get, list: if isMemberOf(rid);

      allow update: if isOwnerOf(rid)
        && changedKeys().hasOnly(['name', 'timezone', 'settings'])
        && validRestaurantUpdate(request.resource.data);

      allow create, delete: if false;

      function validRestaurantUpdate(d) {
        return (!('name' in d) || (d.name is string && d.name.size() >= 2 && d.name.size() <= 80))
          && (!('timezone' in d) || (d.timezone is string && d.timezone.size() >= 3 && d.timezone.size() <= 64))
          && (!('settings' in d) || validSettings(d.settings));
      }

      function validSettings(s) {
        return s.keys().hasOnly(['attendanceMode', 'faceVerifyThreshold', 'faceReviewThreshold', 'requireMarker', 'lateGraceMinutes', 'requireLocation', 'locationLat', 'locationLng', 'locationRadiusMeters'])
          && s.keys().hasAll(['attendanceMode', 'faceVerifyThreshold', 'faceReviewThreshold', 'requireMarker', 'lateGraceMinutes'])
          && s.attendanceMode in ['manual', 'face', 'both']
          && s.faceVerifyThreshold is number
          && s.faceVerifyThreshold >= 0 && s.faceVerifyThreshold <= 1
          && s.faceReviewThreshold is number
          && s.faceReviewThreshold >= 0 && s.faceReviewThreshold <= 1
          && s.faceReviewThreshold <= s.faceVerifyThreshold
          && s.requireMarker is bool
          && s.lateGraceMinutes is int
          && s.lateGraceMinutes >= 0 && s.lateGraceMinutes <= 240
          && (!('requireLocation' in s) || s.requireLocation is bool)
          && (!('locationLat' in s) || (s.locationLat is number && s.locationLat >= -90 && s.locationLat <= 90))
          && (!('locationLng' in s) || (s.locationLng is number && s.locationLng >= -180 && s.locationLng <= 180))
          && (!('locationRadiusMeters' in s) || (s.locationRadiusMeters is number && s.locationRadiusMeters >= 10 && s.locationRadiusMeters <= 5000));
      }

      // ---------- marker secret: functions only ----------
      match /private/{document=**} {
        allow read, write: if false;
      }

      // ---------- employees ----------
      // Staff may edit only the profile fields. `face`, `presence`, `uid`,
      // `active` and `createdAt` are server-owned.
      match /employees/{eid} {
        allow get, list: if isStaffOf(rid) || isEmployeeSelf(rid, eid);

        allow update: if isStaffOf(rid)
          && changedKeys().hasOnly(['name', 'phone', 'position', 'scheduledStart'])
          && validEmployeeProfile(request.resource.data);

        allow create, delete: if false;

        function validEmployeeProfile(d) {
          return (!('name' in d) || (d.name is string && d.name.size() >= 2 && d.name.size() <= 80))
            && (!('phone' in d) || d.phone == null || (d.phone is string && d.phone.size() <= 32))
            && (!('position' in d) || d.position == null || (d.position is string && d.position.size() <= 40))
            && (!('scheduledStart' in d) || d.scheduledStart == null ||
                (d.scheduledStart is string && d.scheduledStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
        }
      }

      // ---------- attendance: read-only for clients ----------
      match /attendance/{recordId} {
        allow get, list: if isStaffOf(rid) ||
          (isMemberOf(rid) && role() == 'employee' && resource.data.employeeId == eid());
        allow write: if false;
      }

      // ---------- photo reuse ledger: functions only ----------
      match /photoHashes/{document=**} {
        allow read, write: if false;
      }
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
